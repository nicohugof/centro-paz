{
  "name": "🌿 Centro Paz (CPAZ) — Publicación Autónoma 28 Días (IG + FB)",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 9,13,18,21 * * *"
            }
          ]
        }
      },
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.1,
      "position": [
        0,
        200
      ],
      "id": "node-schedule-trigger",
      "name": "Cron (09:00, 13:00, 18:00, 21:00)"
    },
    {
      "parameters": {
        "url": "https://www.centropaz.cl/parrilla_semanal_n8n.json",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        220,
        200
      ],
      "id": "node-fetch-schedule",
      "name": "Descargar Parrilla CPAZ"
    },
    {
      "parameters": {
        "jsCode": "const schedule = $json.schedule || [];\nif (!schedule.length) return [];\n\n// Obtenemos el día del mes actual (1 a 28) y la hora aproximada\nconst now = new Date();\nconst currentHour = now.getHours();\nconst dayOfMonth = ((now.getDate() - 1) % 28) + 1;\n\nlet targetTime = \"13:00\";\nif (currentHour < 11) targetTime = \"09:00\";\nelse if (currentHour < 16) targetTime = \"13:00\";\nelse if (currentHour < 20) targetTime = \"18:00\";\nelse targetTime = \"21:00\";\n\nconst item = schedule.find(s => s.dia_global === dayOfMonth && s.hora === targetTime) || schedule[0];\n\nreturn [{\n  json: {\n    id: item.id,\n    title: item.titulo,\n    type: item.tipo,\n    image_url: item.url_imagen,\n    caption: item.caption,\n    cta: item.cta\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        200
      ],
      "id": "node-select-post",
      "name": "Seleccionar Post del Horario"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://graph.facebook.com/v19.0/{{$env.INSTAGRAM_ACCOUNT_ID || 'YOUR_IG_ACCOUNT_ID'}}/media",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"image_url\": \"{{$json.image_url}}\",\n  \"caption\": \"{{$json.caption}}\",\n  \"access_token\": \"{{$env.META_ACCESS_TOKEN || 'YOUR_META_TOKEN'}}\"\n}",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        680,
        100
      ],
      "id": "node-ig-container",
      "name": "1. Crear Contenedor IG"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://graph.facebook.com/v19.0/{{$env.INSTAGRAM_ACCOUNT_ID || 'YOUR_IG_ACCOUNT_ID'}}/media_publish",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"creation_id\": \"{{$json.id}}\",\n  \"access_token\": \"{{$env.META_ACCESS_TOKEN || 'YOUR_META_TOKEN'}}\"\n}",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        920,
        100
      ],
      "id": "node-ig-publish",
      "name": "2. Publicar en Instagram"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://graph.facebook.com/v19.0/{{$env.FACEBOOK_PAGE_ID || '61593207820690'}}/photos",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"url\": \"{{$node[\"Seleccionar Post del Horario\"].json.image_url}}\",\n  \"caption\": \"{{$node[\"Seleccionar Post del Horario\"].json.caption}}\",\n  \"access_token\": \"{{$env.META_ACCESS_TOKEN || 'YOUR_META_TOKEN'}}\"\n}",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        680,
        320
      ],
      "id": "node-fb-publish",
      "name": "Publicar en Facebook Page"
    }
  ],
  "connections": {
    "Cron (09:00, 13:00, 18:00, 21:00)": {
      "main": [
        [
          {
            "node": "Descargar Parrilla CPAZ",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Descargar Parrilla CPAZ": {
      "main": [
        [
          {
            "node": "Seleccionar Post del Horario",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Seleccionar Post del Horario": {
      "main": [
        [
          {
            "node": "1. Crear Contenedor IG",
            "type": "main",
            "index": 0
          },
          {
            "node": "Publicar en Facebook Page",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "1. Crear Contenedor IG": {
      "main": [
        [
          {
            "node": "2. Publicar en Instagram",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  }
}
